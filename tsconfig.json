{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/app/*": ["src/app/*"],

      "@/components/*": ["components/*"],
      "@/hooks/*": ["hooks/*"],

      "@/lib/*": ["src/lib/*"],
      "@/auth": ["src/lib/auth/nextauth.ts"]
    },

    "ignoreDeprecations": "5.0",

    "plugins": [
      {
        "name": "next"
      }
    ],

    "incremental": true,

    "typeRoots": ["./src/types", "./node_modules/@types"]
  },

  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": ["node_modules", "grantscout-pro-mobile"]
}
