import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!
);

// Hard-coded plan limits (can be moved to DB later)
const PLAN_LIMITS: Record<string, any> = {
  trial: {
    grants: 10,
    files: 20,
    structuredExtractions: 20,
  },
  paid: {
    grants: 500,
    files: 2000,
    structuredExtractions: 2000,
  },
};

export async function POST(req: NextRequest, context: { params: Record<string, string> }) {
  try {
    const { workspaceId } = await req.json();

    if (!workspaceId) {
      return NextResponse.json(
        { error: "workspaceId is required" },
        { status: 400 }
      );
    }

    // Fetch workspace plan + billing status
    const { data: workspace, error: workspaceError } = await supabase
      .from("workspaces")
      .select("plan, stripe_subscription_status, status")
      .eq("id", workspaceId)
      .single();

    if (workspaceError || !workspace) {
      console.error("Workspace fetch error:", workspaceError);
      return NextResponse.json(
        { error: "Workspace not found" },
        { status: 404 }
      );
    }

    const plan = workspace.plan || "trial";
    const limits = PLAN_LIMITS[plan];

    // Fetch usage snapshot
    const { data: usage, error: usageError } = await supabase
      .from("workspace_usage")
      .select("usage")
      .eq("workspace_id", workspaceId)
      .order("created_at", { ascending: false })
      .limit(1)
      .single();

    if (usageError || !usage) {
      console.error("Usage fetch error:", usageError);
      return NextResponse.json(
        { error: "No usage snapshot found" },
        { status: 404 }
      );
    }

    const u = usage.usage;

    // Determine over-limit status
    const overLimit = {
      grants: u.grants > limits.grants,
      files: u.files > limits.files,
      structuredExtractions: u.structuredExtractions > limits.structuredExtractions,
    };

    const anyOverLimit = Object.values(overLimit).includes(true);

    // If workspace is trial and over limit → lock
    let workspaceStatus = workspace.status;

    if (plan === "trial" && anyOverLimit) {
      workspaceStatus = "locked";
    }

    // If paid plan but Stripe billing is unhealthy → lock
    const unhealthyBillingStatuses = [
      "past_due",
      "unpaid",
      "canceled",
      "incomplete",
      "incomplete_expired",
    ];

    if (
      plan === "paid" &&
      unhealthyBillingStatuses.includes(workspace.stripe_subscription_status)
    ) {
      workspaceStatus = "locked";
    }

    // Update workspace status if changed
    if (workspaceStatus !== workspace.status) {
      await supabase
        .from("workspaces")
        .update({ status: workspaceStatus })
        .eq("id", workspaceId);
    }

    return NextResponse.json({
      success: true,
      workspaceId,
      plan,
      limits,
      usage: u,
      overLimit,
      anyOverLimit,
      workspaceStatus,
    });
  } catch (err: any) {
    console.error("Billing usage sync route error:", err);
    return NextResponse.json(
      { error: err.message || "Unexpected error" },
      { status: 500 }
    );
  }
}
