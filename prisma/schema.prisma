enum WorkspaceTaskStatus {
  NEW
  IN_PROGRESS
  COMPLETED
}

// Team task assignment (Team/Business/Enterprise tiers - see src/lib/plans.ts
// PlanAccess.tasks). "Past due" is intentionally NOT a stored status: it's
// derived from status + dueDate at read time (see src/lib/tasks.ts), so a
// task completed late correctly shows Completed instead of getting stuck.
model WorkspaceTask {
  id          String              @id @default(cuid())
  workspaceId String
  title       String
  description String?
  status      WorkspaceTaskStatus @default(NEW)
  dueDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  assignedToId String
  assignedById String

  workspace  Workspace @relation("WorkspaceToTask", fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo User      @relation("WorkspaceTaskAssignedTo", fields: [assignedToId], references: [id])
  assignedBy User      @relation("WorkspaceTaskAssignedBy", fields: [assignedById], references: [id])

  @@index([workspaceId])
  @@index([assignedToId])
}
