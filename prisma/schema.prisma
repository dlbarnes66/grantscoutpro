generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  emailVerified DateTime?

  role       String  @default("user")
  superAdmin Boolean @default(false)

  stripeCustomerId String?   @unique
  planName         String?
  status           String?
  renewalDate      DateTime?

  workspaceMembers WorkspaceMember[]
  workspaceInvites WorkspaceInvite[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")

  accounts Account[]
  sessions Session[]

  profile UserProfile?

  applications         Application[]
  applicationHistories ApplicationHistory[]
  grantDrafts          GrantDraft[]
  narratives           Narrative[]

  postAwardHistory          PostAwardHistory[]
  renewalHistory            RenewalHistory[]
  reviewerHistory           ReviewerHistory[]
  riskHistory               RiskHistory[]
  submissionHistory         SubmissionHistory[]
  writingCoachHistory       WritingCoachHistory[]
  forecastHistory           ForecastHistory[]
  matchingHistory           MatchingHistory[]
  opportunityHistory        OpportunityHistory[]
  rewriteHistory            RewriteHistory[]
  panelHistory              PanelHistory[]
  gapsHistory               GapsHistory[]
  narrativeHistory          NarrativeHistory[]
  agentHistory              AgentHistory[]
  complianceHistory         ComplianceHistory[]
  closeoutHistory           CloseoutHistory[]
  eligibilityHistory        EligibilityHistory[]
  autoeditorHistory         AutoeditorHistory[]
  successProbabilityHistory SuccessProbabilityHistory[]
  compareHistory            CompareHistory[]
  portfolioHistory          PortfolioHistory[]
  negotiationHistory        NegotiationHistory[]
  monitoringHistory         MonitoringHistory[]
  outreachHistory           OutreachHistory[]
  budgetHistory             BudgetHistory[]

  grantTruthfulnessHistory GrantTruthfulnessHistory[]
  grantEvidenceHistory     GrantEvidenceHistory[]
  grantCompletenessHistory GrantCompletenessHistory[]
  grantQualityHistory      GrantQualityHistory[]
  grantOptimizationHistory GrantOptimizationHistory[]
  grantEnhancementHistory  GrantEnhancementHistory[]
  grantAuditHistory        GrantAuditHistory[]
  grantReviewerHistory     GrantReviewerHistory[]
  grantDecisionHistory     GrantDecisionHistory[]

  searchHistory SearchHistory[]
  savedSearches SavedSearch[]
  savedGrants   SavedGrant[]

  comparisons GrantComparison[]
  comments    ComparisonComment[]

  notifications          Notification[]
  workspaceNotifications WorkspaceNotification[]

  tasksAssignedToMe WorkspaceTask[] @relation("WorkspaceTaskAssignedTo")
  tasksAssignedByMe WorkspaceTask[] @relation("WorkspaceTaskAssignedBy")

  DocumentPatch    DocumentPatch[]
  Document         Document[]
  DocumentSnapshot DocumentSnapshot[]
  DocumentVersion  DocumentVersion[]
  File             File[]
  DocumentMessage  DocumentMessage[]
  DocumentComment  DocumentComment[]
  DocumentPresence DocumentPresence[]
  Embedding        Embedding[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  activities WorkspaceActivity[]

  documentAccess DocumentAccess[]
  grantAccess    GrantAccess[]

  aiUsage AiUsage[]

  jobs Job[] @relation("UserJobs")

  Org                   Org?                    @relation(fields: [orgId], references: [id])
  orgId                 String?
  ApiKey                ApiKey?
  Report                Report[]
  AuditLog              AuditLog[]
  PortfolioOptimization PortfolioOptimization[]

  emailLogs  EmailLog[]
  Automation Automation[]

  documentActivities      WorkspaceDocumentActivity[]
  billingActivities       WorkspaceBillingActivity[]
  internalActivities      InternalActivity[]
  documentShares          DocumentShare[]
  aiEventLogs             AiEventLog[]
  workspaceSuspensionLogs WorkspaceSuspensionLog[]
  billingLogs             BillingLog[]                @relation("UserBillingLogs")

  chatMessages     ChatMessage[]     @relation("UserChatMessages")
  commentsRealtime Comment[]         @relation("UserComments")
  cursors          Cursor[]          @relation("UserCursors")
  presence         Presence[]        @relation("UserPresence")
  WorkspaceReport  WorkspaceReport[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  organizationName String?
  organizationType String?
  mission          String?
  website          String?

  country String?
  state   String?
  city    String?

  nonprofitStatus String?
  ein             String?

  staffSize       Int?
  annualBudget    Int?
  grantExperience String?

  focusAreas        String[]
  populationsServed String[]
  geographicService String[]

  pastGrants String?
  pastWins   Int?
  pastLosses Int?

  strategicGoals String?
  priorityAreas  String?

  // Populated by the twice-daily website re-scan (Firecrawl + AI
  // extraction), not just the one-time onboarding scrape - keeps grant
  // matching aware of newly announced programs/initiatives instead of
  // only what was true when the org signed up.
  currentProjects Json?
  lastScannedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  members WorkspaceMember[] @relation("WorkspaceToMember")
  invites WorkspaceInvite[] @relation("WorkspaceToInvite")

  integrations WorkspaceIntegration[]

  tasks       WorkspaceTask[] @relation("WorkspaceToTask")
  crmContacts CrmContact[]    @relation("WorkspaceToCrmContact")
  crmDeals    CrmDeal[]       @relation("WorkspaceToCrmDeal")
  crmNotes    CrmNote[]       @relation("WorkspaceToCrmNote")
  crmActivity CrmActivity[]   @relation("WorkspaceToCrmActivity")

  grants      Grant[]           @relation("WorkspaceToGrant")
  comparisons GrantComparison[]

  insights          WorkspaceInsight[] @relation("PrimaryInsights")
  workspaceInsights WorkspaceInsight[] @relation("SecondaryInsights")

  searchAnalytics        SearchAnalytics[]
  workspaceNotifications WorkspaceNotification[] @relation("WorkspaceToNotification")

  applications Application[]
  reports      WorkspaceReport[] @relation("WorkspaceToReport")
  budgets      WorkspaceBudget[] @relation("WorkspaceToBudget")

  documents  WorkspaceDocument[]  @relation("WorkspaceToDocument")
  files      WorkspaceFile[]      @relation("WorkspaceToFile")
  embeddings WorkspaceEmbedding[]

  addons        WorkspaceAddon[]  @relation("WorkspaceToAddon")
  addonBillings AddonBilling[]    @relation("WorkspaceToAddonBilling")
  billing       WorkspaceBilling? @relation("WorkspaceToBilling")

  userDocuments      Document[]
  userFiles          File[]
  globalEmbeddings   Embedding[]
  detailedReports    Report[]
  detailedBudgets    Budget[]
  documentEmbeddings DocumentEmbedding[]
  fileEmbeddings     FileEmbedding[]

  stripeCustomerId   String?
  subscriptionTier   String    @default("basic")
  billingStatus      String    @default("inactive")
  billingPeriod      String    @default("monthly")
  billingRenewalDate DateTime?

  maxSeats     Int @default(1)
  currentSeats Int @default(1)

  trialStart         DateTime?
  trialEnd           DateTime?
  trialActive        Boolean   @default(false)
  trialLocked        Boolean   @default(false)
  trialDaysRemaining Int?
  trialBannerColor   String?
  trialPromoCode     String?   @default("promo10")

  pilotMode             Boolean   @default(false)
  pilotActive           Boolean   @default(false)
  pilotStart            DateTime?
  pilotEndsAt           DateTime?
  pilotLocked           Boolean   @default(false)
  pilotTier             String?
  allowedDowngradeTiers String[]  @default(["basic", "team"])

  state String?
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])

  activities WorkspaceActivity[] @relation("WorkspaceToActivity")
  aiUsage    AiUsage[]           @relation("WorkspaceToAiUsage")

  insightLogs WorkspaceInsightLog[]

  grantTruthfulnessHistory GrantTruthfulnessHistory[]
  grantEvidenceHistory     GrantEvidenceHistory[]
  grantCompletenessHistory GrantCompletenessHistory[]
  grantQualityHistory      GrantQualityHistory[]
  grantOptimizationHistory GrantOptimizationHistory[]
  grantEnhancementHistory  GrantEnhancementHistory[]
  grantAuditHistory        GrantAuditHistory[]
  grantReviewerHistory     GrantReviewerHistory[]
  grantDecisionHistory     GrantDecisionHistory[]

  emailLogs       EmailLog[]
  RiskHistory     RiskHistory[]
  Automation      Automation[]
  AutomationRun   AutomationRun[]
  WorkspaceDigest WorkspaceDigest[]

  suspended   Boolean   @default(false)
  suspendedAt DateTime?

  workspaceDocumentActivities WorkspaceDocumentActivity[]
  workspaceBillingActivities  WorkspaceBillingActivity[]
  aiEventLogs                 AiEventLog[]
  workspaceSuspensionLogs     WorkspaceSuspensionLog[]
  workspaceLocations          WorkspaceLocation[]
  billingLogs                 BillingLog[]                @relation("WorkspaceBillingLogs")

  queueJobs        QueueJob[]    @relation("WorkspaceQueueJobs")
  chatMessages     ChatMessage[] @relation("WorkspaceChatMessages")
  commentsRealtime Comment[]     @relation("WorkspaceComments")
  cursors          Cursor[]      @relation("WorkspaceCursors")
  presence         Presence[]    @relation("WorkspacePresence")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  status      String   @default("active")
  createdAt   DateTime @default(now())

  workspace Workspace @relation("WorkspaceToMember", fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("member")
  invitedById String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  workspace Workspace @relation("WorkspaceToInvite", fields: [workspaceId], references: [id])
  invitedBy User      @relation(fields: [invitedById], references: [id])
}

model SearchAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  workspaceId String
  query       String
  resultCount Int
  durationMs  Int

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceActivity {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation("WorkspaceToActivity", fields: [workspaceId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
}

model WorkspaceNotification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  userId      String?

  type    String
  message String
  read    Boolean @default(false)

  workspace Workspace @relation("WorkspaceToNotification", fields: [workspaceId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
}

model WorkspaceReport {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation("WorkspaceToReport", fields: [workspaceId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
}

model WorkspaceBudget {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation("WorkspaceToBudget", fields: [workspaceId], references: [id])
}

model WorkspaceDocument {
  id          String  @id @default(cuid())
  workspaceId String
  title       String
  content     String?
  sizeBytes   Int?

  workspace Workspace @relation("WorkspaceToDocument", fields: [workspaceId], references: [id])

  accessList DocumentAccess[]

  documentActivities WorkspaceDocumentActivity[]
  documentShares     DocumentShare[]
  aiEventLogs        AiEventLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceFile {
  id          String   @id @default(cuid())
  workspaceId String
  filename    String
  mimeType    String
  size        Int
  url         String
  storage     String
  createdAt   DateTime @default(now())

  workspace Workspace @relation("WorkspaceToFile", fields: [workspaceId], references: [id])
}

model WorkspaceEmbedding {
  id          String   @id @default(cuid())
  workspaceId String
  text        String
  vector      Float[]
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceBilling {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  plan                 String    @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  usageSearches        Int       @default(0)
  usageUploads         Int       @default(0)
  usageMembers         Int       @default(1)
  usageAI              Int       @default(0)
  periodStart          DateTime  @default(now())
  periodEnd            DateTime?

  seats           Int @default(1)
  aiTokensMonthly Int @default(50000)
  aiTokensUsed    Int @default(0)
  documentLimit   Int @default(100)
  storageLimitMb  Int @default(500)

  // Daily manual grant-search allowance (distinct from the monthly
  // usageSearches/period billing counters above) - resets every 24h.
  manualSearchCount   Int      @default(0)
  manualSearchResetAt DateTime @default(now())

  // Stripe subscription status ("active" | "trialing" | "past_due" |
  // "canceled" | "unpaid" | "incomplete"), synced from the
  // customer.subscription.* / invoice.payment_* webhook events.
  // Defaults to "active" for the free tier and existing rows.
  status            String  @default("active")
  cancelAtPeriodEnd Boolean @default(false)

  workspace Workspace @relation("WorkspaceToBilling", fields: [workspaceId], references: [id])
}

model WorkspaceAddon {
  id          String  @id @default(cuid())
  workspaceId String
  addonType   String
  active      Boolean @default(true)

  // Set only for a self-serve, separately-billed addon (e.g. the CRM
  // addon purchased outside the Enterprise plan). An addon that's simply
  // included with a plan tier has no Stripe records of its own here.
  stripeSubscriptionId String? @unique
  stripeCustomerId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation("WorkspaceToAddon", fields: [workspaceId], references: [id])

  addonBillings AddonBilling[]

  @@unique([workspaceId, addonType])
}

model AddonBilling {
  id          String   @id @default(cuid())
  workspaceId String
  addonId     String
  amount      Int
  period      String
  status      String   @default("inactive")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation("WorkspaceToAddonBilling", fields: [workspaceId], references: [id])
  addon     WorkspaceAddon @relation(fields: [addonId], references: [id])
}

model WorkspaceInsight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  primaryWorkspaceId   String
  secondaryWorkspaceId String

  title       String
  description String?
  aiScore     Float?

  workspacePrimary   Workspace @relation("PrimaryInsights", fields: [primaryWorkspaceId], references: [id])
  workspaceSecondary Workspace @relation("SecondaryInsights", fields: [secondaryWorkspaceId], references: [id])
}

// A single-workspace AI-generated insight snapshot (trends across a
// workspace's own grants, pipeline, and activity) - distinct from
// WorkspaceInsight above, which compares two different workspaces.
model WorkspaceInsightLog {
  id          String   @id @default(cuid())
  workspaceId String
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI-assisted submission package: status moves draft -> ready when the
  // user reviews and finalizes it (this app never submits to a funder's
  // own site - "ready" just means it's done and exported). budget holds
  // the AI-generated line items separately from the narrative in content.
  status String @default("draft")
  budget Json?

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])

  versions ApplicationVersion[]

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
}

model Embedding {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  grantPageId String?
  GrantPage   GrantPage? @relation(fields: [grantPageId], references: [id])

  vector Float[]

  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  title       String?
  content     Json?
  createdAt   DateTime @default(now())

  lockedBy String?

  embedding  Float[]
  summary    String?
  matchScore Float?
  updatedAt  DateTime? @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  patches          DocumentPatch[]
  versions         DocumentVersion[]
  snapshots        DocumentSnapshot[]
  DocumentMessage  DocumentMessage[]
  DocumentComment  DocumentComment[]
  DocumentPresence DocumentPresence[]
  Embedding        Embedding[]
  File             File[]

  documentEmbeddings DocumentEmbedding[]
}

model Budget {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  amount      Float?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model DocumentEmbedding {
  id          String @id @default(cuid())
  documentId  String
  workspaceId String
  content     String

  embedding Bytes
  vector    Float[]

  createdAt DateTime @default(now())

  document  Document  @relation(fields: [documentId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([documentId])
}

model FileEmbedding {
  id          String  @id @default(cuid())
  fileId      String  @unique
  workspaceId String
  text        String
  vector      Float[]

  file      File      @relation(fields: [fileId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model File {
  id          String  @id @default(cuid())
  workspaceId String?
  userId      String?
  documentId  String?

  filename String
  mimeType String
  size     Int
  url      String
  storage  String

  createdAt DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  document  Document?  @relation(fields: [documentId], references: [id])

  FileEmbedding FileEmbedding?
}

enum GrantSource {
  FEDERAL
  STATE
  FOUNDATION
  PHILANTHROPIC
}

enum GrantTierAccess {
  FEDERAL_ONLY
  FEDERAL_STATE
  PRO
  ENTERPRISE
}

model Grant {
  id          String @id @default(cuid())
  workspaceId String

  title       String
  description String?
  category    String?
  agency      String?
  summary     String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  amount         Float?
  amountMin      Float?
  amountMax      Float?
  totalFunding   Float?
  awardFloor     Float?
  awardCeiling   Float?
  expectedAwards Int?

  deadline    DateTime?
  openDate    DateTime?
  postedDate  DateTime?
  updatedDate DateTime?

  industry             String?
  location             String?
  eligibleStates       String?
  geographicFocus      String?
  eligibleApplicants   String?
  ineligibleApplicants String?
  eligibility          Json?

  foundationName         String?
  foundationEIN          String?
  foundationMission      String?
  foundationRestrictions String?
  foundationGivingAreas  String?
  foundationPastGrantees Json?
  foundationBoardMembers Json?
  foundation990PF        Json?

  philanthropicType    String?
  philanthropicFocus   String?
  philanthropicHistory Json?

  aiEligibilityScore     Float?
  aiAlignmentScore       Float?
  aiCompetitivenessScore Float?
  aiRiskScore            Float?
  aiReadinessScore       Float?
  aiSummary              String?
  aiRecommendations      Json?

  embedding Float[] @default([])
  raw       Json?

  url String?

  workspace Workspace @relation("WorkspaceToGrant", fields: [workspaceId], references: [id])

  applications         Application[]
  applicationHistories ApplicationHistory[]

  narratives        Narrative[]
  documents         GrantDocument[]
  GrantDraft        GrantDraft[]
  GrantSection      GrantSection[]
  ClusterAssignment ClusterAssignment[]

  postAwardHistory          PostAwardHistory[]
  renewalHistory            RenewalHistory[]
  reviewerHistory           ReviewerHistory[]
  riskHistory               RiskHistory[]
  submissionHistory         SubmissionHistory[]
  writingCoachHistory       WritingCoachHistory[]
  forecastHistory           ForecastHistory[]
  matchingHistory           MatchingHistory[]
  opportunityHistory        OpportunityHistory[]
  rewriteHistory            RewriteHistory[]
  panelHistory              PanelHistory[]
  gapsHistory               GapsHistory[]
  narrativeHistory          NarrativeHistory[]
  agentHistory              AgentHistory[]
  complianceHistory         ComplianceHistory[]
  closeoutHistory           CloseoutHistory[]
  eligibilityHistory        EligibilityHistory[]
  autoeditorHistory         AutoeditorHistory[]
  successProbabilityHistory SuccessProbabilityHistory[]
  compareHistory            CompareHistory[]
  portfolioHistory          PortfolioHistory[]
  negotiationHistory        NegotiationHistory[]
  monitoringHistory         MonitoringHistory[]
  outreachHistory           OutreachHistory[]
  budgetHistory             BudgetHistory[]

  truthfulnessHistory  GrantTruthfulnessHistory[]
  evidenceHistory      GrantEvidenceHistory[]
  completenessHistory  GrantCompletenessHistory[]
  qualityHistory       GrantQualityHistory[]
  optimizationHistory  GrantOptimizationHistory[]
  enhancementHistory   GrantEnhancementHistory[]
  auditHistory         GrantAuditHistory[]
  grantReviewerHistory GrantReviewerHistory[]
  decisionHistory      GrantDecisionHistory[]

  tags                  String[]
  SavedGrant            SavedGrant[]
  PortfolioOptimization PortfolioOptimization[]
  GrantAccess           GrantAccess[]

  source     GrantSource     @default(FEDERAL)
  tierAccess GrantTierAccess @default(FEDERAL_ONLY)
}

model GrantDocument {
  id        String   @id @default(cuid())
  grantId   String
  filename  String
  url       String
  createdAt DateTime @default(now())

  grant Grant @relation(fields: [grantId], references: [id])
}

model GrantSection {
  id      String  @id @default(cuid())
  grantId String
  title   String
  content String?
  order   Int

  grant Grant @relation(fields: [grantId], references: [id])
}

model GrantDraft {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  title     String?
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model Narrative {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  content   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model PostAwardHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model RenewalHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  status    String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model ReviewerHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  reviewer  String?
  comments  String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model RiskHistory {
  id          String   @id @default(cuid())
  userId      String
  grantId     String
  workspaceId String?
  riskLevel   String?
  notes       String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  grant     Grant      @relation(fields: [grantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
}

model SubmissionHistory {
