generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?

  role       String  @default("user")
  superAdmin Boolean @default(false)

  accounts             Account[]
  sessions             Session[]
  jobs                 Job[]                @relation("UserJobs")
  searchHistory        SearchHistory[]
  savedSearches        SavedSearch[]
  savedGrants          SavedGrant[]
  comparisons          GrantComparison[]
  comments             ComparisonComment[]
  notifications        Notification[]
  applicationHistories ApplicationHistory[]
  applications         Application[]

  profile UserProfile?

  // Stripe
  stripeCustomerId String?   @unique
  planName         String?
  status           String?
  renewalDate      DateTime?

  // Workspace membership + invites
  workspaceMembers WorkspaceMember[]
  workspaceInvites WorkspaceInvite[]

  // Inverse for Workspace.owner
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")

  grantDrafts GrantDraft[]

  narratives Narrative[]
  reports    Report[]
  auditLogs  AuditLog[]

  portfolioOptimizations PortfolioOptimization[]

  postAwardHistory          PostAwardHistory[]
  renewalHistory            RenewalHistory[]
  reviewerHistory           ReviewerHistory[]
  riskHistory               RiskHistory[]
  submissionHistory         SubmissionHistory[]
  writingCoachHistory       WritingCoachHistory[]
  forecastHistory           ForecastHistory[]
  matchingHistory           MatchingHistory[]
  opportunityHistory        OpportunityHistory[]
  rewriteHistory            RewriteHistory[]
  panelHistory              PanelHistory[]
  gapsHistory               GapsHistory[]
  narrativeHistory          NarrativeHistory[]
  agentHistory              AgentHistory[]
  complianceHistory         ComplianceHistory[]
  closeoutHistory           CloseoutHistory[]
  eligibilityHistory        EligibilityHistory[]
  autoeditorHistory         AutoeditorHistory[]
  successProbabilityHistory SuccessProbabilityHistory[]
  compareHistory            CompareHistory[]
  portfolioHistory          PortfolioHistory[]
  negotiationHistory        NegotiationHistory[]
  monitoringHistory         MonitoringHistory[]
  outreachHistory           OutreachHistory[]
  budgetHistory             BudgetHistory[]

  ApiKey           ApiKey[]
  DocumentPatch    DocumentPatch[]
  Document         Document[]
  DocumentSnapshot DocumentSnapshot[]
  DocumentVersion  DocumentVersion[]
  File             File[]

  // Messaging
  sentMessages     Message[]          @relation("SentMessages")
  receivedMessages Message[]          @relation("ReceivedMessages")
  DocumentMessage  DocumentMessage[]
  DocumentComment  DocumentComment[]
  DocumentPresence DocumentPresence[]
  Embedding        Embedding[]

  // Workspace activity
  activities WorkspaceActivity[]

  // Inverse for WorkspaceNotification.user
  workspaceNotifications WorkspaceNotification[]

  // Inverse for WorkspaceReport.user
  workspaceReports WorkspaceReport[]

  // FIXED ACL RELATIONS
  documentAccess DocumentAccess[]
  grantAccess    GrantAccess[]

  // AI Usage (inverse relation)
  aiUsage AiUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  organizationName String?
  organizationType String?
  mission          String?
  website          String?

  country String?
  state   String?
  city    String?

  nonprofitStatus String?
  ein             String?

  staffSize       Int?
  annualBudget    Int?
  grantExperience String?

  focusAreas        String[]
  populationsServed String[]
  geographicService String[]

  pastGrants String?
  pastWins   Int?
  pastLosses Int?

  strategicGoals String?
  priorityAreas  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner
  ownerId String
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  // Members
  members WorkspaceMember[] @relation("WorkspaceToMember")
  invites WorkspaceInvite[] @relation("WorkspaceToInvite")

  // Grants & Intelligence
  grants      Grant[]            @relation("WorkspaceToGrant")
  comparisons GrantComparison[]

  // Insights (Primary + Secondary)
  insights          WorkspaceInsight[] @relation("PrimaryInsights")
  workspaceInsights WorkspaceInsight[] @relation("SecondaryInsights")

  // Analytics & Notifications
  searchAnalytics        SearchAnalytics[]
  workspaceNotifications WorkspaceNotification[] @relation("WorkspaceToNotification")

  // Applications
  applications Application[]
  reports      WorkspaceReport[] @relation("WorkspaceToReport")
  budgets      WorkspaceBudget[] @relation("WorkspaceToBudget")

  // Workspace-level Documents & Files
  documents  WorkspaceDocument[] @relation("WorkspaceToDocument")
  files      WorkspaceFile[]     @relation("WorkspaceToFile")
  embeddings WorkspaceEmbedding[]

  // Addons + Addon Billing
  addons        WorkspaceAddon[]   @relation("WorkspaceToAddon")
  addonBillings AddonBilling[]     @relation("WorkspaceToAddonBilling")

  // Global models referencing Workspace
  userDocuments      Document[]
  userFiles          File[]
  globalEmbeddings   Embedding[]
  detailedReports    Report[]
  detailedBudgets    Budget[]
  documentEmbeddings DocumentEmbedding[]
  fileEmbeddings     FileEmbedding[]

  // Billing (one-to-one)
  billing WorkspaceBilling? @relation("WorkspaceToBilling")

  // ─────────────────────────────────────────
  // Workspace-level billing + seats + trials
  // ─────────────────────────────────────────

  stripeCustomerId   String?
  subscriptionTier   String   @default("basic")
  billingStatus      String   @default("inactive")
  billingPeriod      String   @default("monthly")
  billingRenewalDate DateTime?

  maxSeats     Int @default(1)
  currentSeats Int @default(1)

  trialStart        DateTime?
  trialEnd          DateTime?
  trialActive       Boolean  @default(false)
  trialLocked       Boolean  @default(false)
  trialDaysRemaining Int?
  trialBannerColor   String?
  trialPromoCode     String? @default("promo10")

  pilotMode        Boolean   @default(false)
  pilotActive      Boolean   @default(false)
  pilotStart       DateTime?
  pilotEndsAt      DateTime?
  pilotLocked      Boolean   @default(false)
  pilotTier        String?
  allowedDowngradeTiers String[] @default(["basic", "team"])

  // Organization
  state String?
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])

  // Activity
  activities WorkspaceActivity[] @relation("WorkspaceToActivity")

  // AI Usage
  aiUsage AiUsage[] @relation("WorkspaceToAiUsage")
}


model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToMember", fields: [workspaceId], references: [id])

  // Relation to User
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  invitedById String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToInvite", fields: [workspaceId], references: [id])

  // Relation to User
  invitedBy User @relation(fields: [invitedById], references: [id])
}


model SearchAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  workspaceId String
  query       String
  resultCount Int
  durationMs  Int

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceActivity {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToActivity", fields: [workspaceId], references: [id])

  // Relation to User
  user      User?     @relation(fields: [userId], references: [id])
}

model WorkspaceNotification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  userId      String?

  type    String
  message String
  read    Boolean @default(false)

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToNotification", fields: [workspaceId], references: [id])

  // Relation to User
  user      User?     @relation(fields: [userId], references: [id])
}


model WorkspaceReport {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToReport", fields: [workspaceId], references: [id])

  // Relation to User
  user      User?     @relation(fields: [userId], references: [id])
}

model WorkspaceBudget {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToBudget", fields: [workspaceId], references: [id])
}

model WorkspaceDocument {
  id          String  @id @default(cuid())
  workspaceId String
  title       String
  content     String?

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToDocument", fields: [workspaceId], references: [id])

  // ACL relation
  accessList DocumentAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceFile {
  id          String   @id @default(cuid())
  workspaceId String
  filename    String
  mimeType    String
  size        Int
  url         String
  storage     String
  createdAt   DateTime @default(now())

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToFile", fields: [workspaceId], references: [id])
}


model WorkspaceEmbedding {
  id          String   @id @default(cuid())
  workspaceId String
  text        String
  vector      Float[]
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceBilling {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  plan                 String    @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  usageSearches        Int       @default(0)
  usageUploads         Int       @default(0)
  usageMembers         Int       @default(1)
  usageAI              Int       @default(0)
  periodStart          DateTime  @default(now())
  periodEnd            DateTime?

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToBilling", fields: [workspaceId], references: [id])
}


model WorkspaceAddon {
  id           String   @id @default(cuid())
  workspaceId  String
  addonType    String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToAddon", fields: [workspaceId], references: [id])

  // Billing for this addon
  addonBillings AddonBilling[]
}

model AddonBilling {
  id           String   @id @default(cuid())
  workspaceId  String
  addonId      String
  amount       Int
  period       String   // "monthly" | "annual"
  status       String   @default("inactive")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToAddonBilling", fields: [workspaceId], references: [id])

  // Correct relation to WorkspaceAddon
  addon WorkspaceAddon @relation(fields: [addonId], references: [id])
}

model WorkspaceInsight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  primaryWorkspaceId   String
  secondaryWorkspaceId String

  title       String
  description String?
  aiScore     Float?

  // Primary Workspace relation
  workspacePrimary   Workspace @relation("PrimaryInsights", fields: [primaryWorkspaceId], references: [id])

  // Secondary Workspace relation
  workspaceSecondary Workspace @relation("SecondaryInsights", fields: [secondaryWorkspaceId], references: [id])
}


model Application {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])

  versions ApplicationVersion[]

  // Added to match Workspace.applications
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
}

model Embedding {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  vector Float[]

  createdAt   DateTime   @default(now())
  GrantPage   GrantPage? @relation(fields: [grantPageId], references: [id])
  grantPageId String?
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  title       String?
  content     Json?
  createdAt   DateTime @default(now())

  lockedBy    String?

  // Semantic Engine Fields
  embedding   Float[]       // Primary embedding vector
  summary     String?       // Semantic summary of the document
  matchScore  Float?        // Score from semantic search
  updatedAt   DateTime? @updatedAt

  // Relations
  workspace         Workspace?        @relation(fields: [workspaceId], references: [id])
  user              User?             @relation(fields: [userId], references: [id])

  patches           DocumentPatch[]
  versions          DocumentVersion[]
  snapshots         DocumentSnapshot[]
  DocumentMessage   DocumentMessage[]
  DocumentComment   DocumentComment[]
  DocumentPresence  DocumentPresence[]
  Embedding         Embedding[]
  File              File[]

  documentEmbeddings DocumentEmbedding[]
}

model Budget {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  amount      Float?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model DocumentEmbedding {
  id          String   @id @default(cuid())
  documentId  String
  workspaceId String
  content     String

  embedding   Bytes

  createdAt   DateTime @default(now())

  document    Document   @relation(fields: [documentId], references: [id])
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([documentId])
}

model FileEmbedding {
  id          String  @id @default(cuid())
  fileId      String  @unique
  workspaceId String
  text        String
  vector      Float[]

  file      File      @relation(fields: [fileId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model File {
  id          String  @id @default(cuid())
  workspaceId String?
  userId      String?
  documentId  String?

  filename String
  mimeType String
  size     Int
  url      String
  storage  String

  createdAt DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  document  Document?  @relation(fields: [documentId], references: [id])

  FileEmbedding FileEmbedding?
}

enum GrantSource {
  FEDERAL
  STATE
  FOUNDATION
  PHILANTHROPIC
}

enum GrantTierAccess {
  FEDERAL_ONLY
  FEDERAL_STATE
  PRO
  ENTERPRISE
}

model Grant {
  id           String    @id @default(cuid())
  workspaceId  String
  title        String
  description  String?
  category     String?
  agency       String?
  summary      String?
  amount       Float?
  deadline     DateTime?
  openDate     DateTime?
  url          String?
  industry     String?
  location     String?
  fundingRange String?
  status       String    @default("open")
  embedding    Float[]   @default([])

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationHistories ApplicationHistory[]
  applications         Application[]

  // Correct relation to Workspace
  workspace Workspace @relation("WorkspaceToGrant", fields: [workspaceId], references: [id])

  narratives Narrative[]

  postAwardHistory          PostAwardHistory[]
  renewalHistory            RenewalHistory[]
  reviewerHistory           ReviewerHistory[]
  riskHistory               RiskHistory[]
  submissionHistory         SubmissionHistory[]
  writingCoachHistory       WritingCoachHistory[]
  forecastHistory           ForecastHistory[]
  matchingHistory           MatchingHistory[]
  opportunityHistory        OpportunityHistory[]
  rewriteHistory            RewriteHistory[]
  panelHistory              PanelHistory[]
  gapsHistory               GapsHistory[]
  narrativeHistory          NarrativeHistory[]
  agentHistory              AgentHistory[]
  complianceHistory         ComplianceHistory[]
  closeoutHistory           CloseoutHistory[]
  eligibilityHistory        EligibilityHistory[]
  autoeditorHistory         AutoeditorHistory[]
  successProbabilityHistory SuccessProbabilityHistory[]
  compareHistory            CompareHistory[]
  portfolioHistory          PortfolioHistory[]
  negotiationHistory        NegotiationHistory[]
  monitoringHistory         MonitoringHistory[]
  outreachHistory           OutreachHistory[]
  budgetHistory             BudgetHistory[]

  documents         GrantDocument[]
  GrantDraft        GrantDraft[]
  GrantSection      GrantSection[]
  ClusterAssignment ClusterAssignment[]

  source     GrantSource     @default(FEDERAL)
  tierAccess GrantTierAccess @default(FEDERAL_ONLY)

  amountMin      Float?
  amountMax      Float?
  totalFunding   Float?
  awardFloor     Float?
  awardCeiling   Float?
  expectedAwards Int?

  postedDate  DateTime?
  updatedDate DateTime?

  eligibility          Json?
  eligibleApplicants   String?
  ineligibleApplicants String?

  eligibleStates  String?
  geographicFocus String?

  foundationName         String?
  foundationEIN          String?
  foundationMission      String?
  foundationRestrictions String?
  foundationGivingAreas  String?
  foundationPastGrantees Json?
  foundationBoardMembers Json?
  foundation990PF        Json?

  philanthropicType    String?
  philanthropicFocus   String?
  philanthropicHistory Json?

  aiEligibilityScore     Float?
  aiAlignmentScore       Float?
  aiCompetitivenessScore Float?
  aiRiskScore            Float?
  aiReadinessScore       Float?

  aiSummary         String?
  aiRecommendations Json?

  tags                  String[]
  SavedGrant            SavedGrant[]
  PortfolioOptimization PortfolioOptimization[]
  GrantAccess           GrantAccess[]
}


model GrantDocument {
  id        String   @id @default(cuid())
  grantId   String
  filename  String
  url       String
  createdAt DateTime @default(now())

  grant Grant @relation(fields: [grantId], references: [id])
}

model GrantSection {
  id      String  @id @default(cuid())
  grantId String
  title   String
  content String?
  order   Int

  grant Grant @relation(fields: [grantId], references: [id])
}

model GrantDraft {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  title     String?
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model Narrative {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  content   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model PostAwardHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model RenewalHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  status    String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model ReviewerHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  reviewer  String?
  comments  String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model RiskHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  riskLevel String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model SubmissionHistory {
  id          String    @id @default(cuid())
  userId      String
  grantId     String
  status      String?
  submittedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])

  submissionVersions SubmissionVersion[]
}

model SubmissionVersion {
  id            String   @id @default(cuid())
  submissionId  String
  versionNumber Int
  content       String?
  createdAt     DateTime @default(now())

  submission SubmissionHistory @relation(fields: [submissionId], references: [id])
}

model WritingCoachHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  advice    String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model ForecastHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  forecast  String?
  score     Float?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model MatchingHistory {
  id         String   @id @default(cuid())
  userId     String
  grantId    String
  matchScore Float?
  notes      String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model OpportunityHistory {
  id          String   @id @default(cuid())
  userId      String
  grantId     String
  opportunity String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model RewriteHistory {
  id      String @id @default(cuid())
  userId  String
  grantId String

  original  String?
  rewritten String?
  tone      String?

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model PanelHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  panel     String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model GapsHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  gaps      String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model NarrativeHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  section   String?
  content   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model AgentHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  agent     String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model ComplianceHistory {
  id         String   @id @default(cuid())
  userId     String
  grantId    String
  compliance String?
  notes      String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model CloseoutHistory {
  id        String   @id @default(cuid())
  userId    String
