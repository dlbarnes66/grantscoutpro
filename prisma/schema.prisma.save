generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?

  role String @default("user")

  accounts             Account[]
  sessions             Session[]
  jobs                 Job[]                @relation("UserJobs")
  searchHistory        SearchHistory[]
  savedSearches        SavedSearch[]
  savedGrants          SavedGrant[]
  comparisons          GrantComparison[]
  comments             ComparisonComment[]
  notifications        Notification[]
  applicationHistories ApplicationHistory[]
  applications         Application[]

  profile UserProfile?

  // ⭐ REQUIRED FOR STRIPE WEBHOOKS
  stripeCustomerId String?   @unique
  planName         String?
  status           String?
  renewalDate      DateTime?

  workspaceMembers WorkspaceMember[]
  workspaceInvites WorkspaceInvite[]

  grantDrafts GrantDraft[]

  narratives Narrative[]
  reports    Report[]
  auditLogs  AuditLog[]

  portfolioOptimizations PortfolioOptimization[]

  postAwardHistory          PostAwardHistory[]
  renewalHistory            RenewalHistory[]
  reviewerHistory           ReviewerHistory[]
  riskHistory               RiskHistory[]
  submissionHistory         SubmissionHistory[]
  writingCoachHistory       WritingCoachHistory[]
  forecastHistory           ForecastHistory[]
  matchingHistory           MatchingHistory[]
  opportunityHistory        OpportunityHistory[]
  rewriteHistory            RewriteHistory[]
  panelHistory              PanelHistory[]
  gapsHistory               GapsHistory[]
  narrativeHistory          NarrativeHistory[]
  agentHistory              AgentHistory[]
  complianceHistory         ComplianceHistory[]
  closeoutHistory           CloseoutHistory[]
  eligibilityHistory        EligibilityHistory[]
  autoeditorHistory         AutoeditorHistory[]
  successProbabilityHistory SuccessProbabilityHistory[]
  compareHistory            CompareHistory[]
  portfolioHistory          PortfolioHistory[]
  negotiationHistory        NegotiationHistory[]
  monitoringHistory         MonitoringHistory[]
  outreachHistory           OutreachHistory[]
  budgetHistory             BudgetHistory[]

  ApiKey           ApiKey[]
  DocumentPatch    DocumentPatch[]
  Document         Document[]
  DocumentSnapshot DocumentSnapshot[]
  DocumentVersion  DocumentVersion[]
  File             File[]

  // ⭐ Correct messaging relations
  sentMessages     Message[]          @relation("SentMessages")
  receivedMessages Message[]          @relation("ReceivedMessages")
  DocumentMessage  DocumentMessage[]
  DocumentComment  DocumentComment[]
  DocumentPresence DocumentPresence[]
  Embedding        Embedding[]

  // ⭐ REQUIRED inverse relation for WorkspaceActivity
  activities WorkspaceActivity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  organizationName String?
  organizationType String?
  mission          String?
  website          String?

  country String?
  state   String?
  city    String?

  nonprofitStatus String?
  ein             String?

  staffSize       Int?
  annualBudget    Int?
  grantExperience String?

  focusAreas        String[]
  populationsServed String[]
  geographicService String[]

  pastGrants String?
  pastWins   Int?
  pastLosses Int?

  strategicGoals String?
  priorityAreas  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}
model Workspace {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Owner
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id])

  // Members
  members            WorkspaceMember[]
  invites            WorkspaceInvite[]

  // Grants & Intelligence
  grants             Grant[]
  comparisons        GrantComparison[]

  // FIXED — unique relation names
  insights           WorkspaceInsight[] @relation("PrimaryInsights")
  workspaceInsights  WorkspaceInsight[] @relation("SecondaryInsights")

  searchAnalytics    SearchAnalytics[]
  workspaceNotifications WorkspaceNotification[]

  // Applications
  applications       Application[]
  reports            WorkspaceReport[]
  budgets            WorkspaceBudget[]

  // Documents & Files
  documents          WorkspaceDocument[]
  files              WorkspaceFile[]
  embeddings         WorkspaceEmbedding[]

  // Billing (one-to-one)
  billing            WorkspaceBilling?

  // Trial System
  trialStart         DateTime?
  trialEnd           DateTime?
  trialActive        Boolean   @default(false)
  trialLocked        Boolean   @default(false)

  // Addons
  addons             WorkspaceAddon[]

  // Organization
  state              String?
  orgId              String?
  org                Org? @relation(fields: [orgId], references: [id])

  // Activity
  activities         WorkspaceActivity[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}


model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  invitedById String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  invitedBy User      @relation(fields: [invitedById], references: [id])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Job {
  id        String   @id @default(cuid())
  text      String
  input     Json?
  status    String   @default("queued")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs   JobLog[]
  result JobResult?

  userId String?
  user   User?   @relation("UserJobs", fields: [userId], references: [id])
}

model JobLog {
  id        String   @id @default(cuid())
  jobId     String
  message   String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])
}

model JobResult {
  id        String   @id @default(cuid())
  jobId     String   @unique
  result    Json
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])
}

model BillingLog {
  id        String   @id @default(cuid())
  type      String
  message   String
  createdAt DateTime @default(now())
}

model GrantPage {
  id        String   @id @default(cuid())
  url       String   @unique
  title     String?
  content   String?
  createdAt DateTime @default(now())

  embeddings Embedding[]
}

model Embedding {
  id String @id @default(cuid())

  // Multi-tenant boundary
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Optional: embeddings tied to a specific document
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  // Optional: embeddings tied to a specific user
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // The actual embedding vector
  vector Float[]

  createdAt   DateTime   @default(now())
  GrantPage   GrantPage? @relation(fields: [grantPageId], references: [id])
  grantPageId String?
}
model GrantPreview {
  id       String  @id @default(cuid())
  title    String
  summary  String
  amount   String?
  deadline String?
  category String?
  agency   String?
  url      String?
  content  String?

  eligibilityScore Float?
  fitScore         Float?
  riskScore        Float?
  competitiveness  Float?
  fundingStrength  Float?
  overallScore     Float?

  fitExplanation String?
  risks          String?
  nextSteps      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedBy SavedGrant[]
}

model SavedGrant {
  id      String @id @default(cuid())
  userId  String
  grantId String

  title  String
  agency String?
  url    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id])
  grant GrantPreview @relation(fields: [grantId], references: [id])
}

model GrantComparison {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  grants Json

  name String? @default("Untitled Comparison")

  analysis Json?

  sharedWith String[] @default([])

  activities ComparisonActivity[]
  comments   ComparisonComment[]
}

model ComparisonActivity {
  id           String   @id @default(cuid())
  comparisonId String
  userId       String?
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  comparison GrantComparison @relation(fields: [comparisonId], references: [id])
}

model ComparisonComment {
  id           String   @id @default(cuid())
  comparisonId String
  userId       String
  text         String
  createdAt    DateTime @default(now())

  comparison GrantComparison @relation(fields: [comparisonId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model FederalGrant {
  id         String    @id @default(cuid())
  externalId String    @unique
  source     String
  title      String
  summary    String?
  agency     String?
  category   String?
  amount     Float?
  deadline   DateTime?
  url        String?
  raw        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model IngestionLog {
  id         String   @id @default(cuid())
  source     String
  status     String
  message    String?
  itemCount  Int?
  startedAt  DateTime @default(now())
  finishedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  orgId     String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  org  Org?  @relation(fields: [orgId], references: [id])
}

model PortfolioOptimization {
  id        String   @id @default(cuid())
  userId    String
  grantIds  String[]
  result    Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PostAwardHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model RenewalHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  status    String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model ReviewerHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  reviewer  String?
  comments  String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model RiskHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  riskLevel String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model SubmissionHistory {
  id          String    @id @default(cuid())
  userId      String
  grantId     String
  status      String?
  submittedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])

  submissionVersions SubmissionVersion[]
}

model WritingCoachHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  advice    String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model ForecastHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  forecast  String?
  score     Float?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model MatchingHistory {
  id         String   @id @default(cuid())
  userId     String
  grantId    String
  matchScore Float?
  notes      String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model OpportunityHistory {
  id          String   @id @default(cuid())
  userId      String
  grantId     String
  opportunity String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model RewriteHistory {
  id      String @id @default(cuid())
  userId  String
  grantId String

  original  String?
  rewritten String?
  tone      String?

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model PanelHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  panel     String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model GapsHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  gaps      String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model NarrativeHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  section   String?
  content   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model AgentHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  agent     String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model ComplianceHistory {
  id         String   @id @default(cuid())
  userId     String
  grantId    String
  compliance String?
  notes      String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model CloseoutHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  closeout  String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model EligibilityHistory {
  id          String   @id @default(cuid())
  userId      String
  grantId     String
  eligibility String?
  notes       String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model AutoeditorHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  edits     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model SuccessProbabilityHistory {
  id          String   @id @default(cuid())
  userId      String
  grantId     String
  probability Float?
  notes       String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model CompareHistory {
  id         String   @id @default(cuid())
  userId     String
  grantId    String
  comparison Json?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model PortfolioHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  portfolio Json?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model NegotiationHistory {
  id          String   @id @default(cuid())
  userId      String
  grantId     String
  negotiation String?
  notes       String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model MonitoringHistory {
  id         String   @id @default(cuid())
  userId     String
  grantId    String
  monitoring String?
  notes      String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model OutreachHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  outreach  String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model BudgetHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  category  String?
  amount    Float?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model SubmissionVersion {
  id            String   @id @default(cuid())
  submissionId  String
  versionNumber Int
  content       String?
  createdAt     DateTime @default(now())

  submission SubmissionHistory @relation(fields: [submissionId], references: [id])
}

model ApplicationHistory {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  status    String?
  notes     String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model ApplicationVersion {
  id            String   @id @default(cuid())
  applicationId String
  versionNumber Int
  content       String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])

  versions ApplicationVersion[]
}

model CrmLead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String   @unique
  key       String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DocumentPatch {
  id        String   @id @default(cuid())
  docId     String
  userId    String
  patch     Json
  createdAt DateTime @default(now())

  document Document @relation(fields: [docId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model DocumentVersion {
  id        String   @id @default(cuid())
  docId     String
  userId    String
  content   Json
  createdAt DateTime @default(now())

  document Document @relation(fields: [docId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model DocumentSnapshot {
  id        String   @id @default(cuid())
  docId     String
  userId    String
  content   Json
  createdAt DateTime @default(now())

  document Document @relation(fields: [docId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}
model Grant {
  id           String    @id @default(cuid())
  workspaceId  String
  title        String
  description  String?
  category     String?
  agency       String?
  summary      String?
  amount       Float?
  deadline     DateTime?
  openDate     DateTime?
  url          String?
  industry     String?
  location     String?
  fundingRange String?
  status       String    @default("open")
  embedding    Float[]   @default([])

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationHistories ApplicationHistory[]
  applications         Application[]

  workspace  Workspace   @relation(fields: [workspaceId], references: [id])
  narratives Narrative[]

  postAwardHistory          PostAwardHistory[]
  renewalHistory            RenewalHistory[]
  reviewerHistory           ReviewerHistory[]
  riskHistory               RiskHistory[]
  submissionHistory         SubmissionHistory[]
  writingCoachHistory       WritingCoachHistory[]
  forecastHistory           ForecastHistory[]
  matchingHistory           MatchingHistory[]
  opportunityHistory        OpportunityHistory[]
  rewriteHistory            RewriteHistory[]
  panelHistory              PanelHistory[]
  gapsHistory               GapsHistory[]
  narrativeHistory          NarrativeHistory[]
  agentHistory              AgentHistory[]
  complianceHistory         ComplianceHistory[]
  closeoutHistory           CloseoutHistory[]
  eligibilityHistory        EligibilityHistory[]
  autoeditorHistory         AutoeditorHistory[]
  successProbabilityHistory SuccessProbabilityHistory[]
  compareHistory            CompareHistory[]
  portfolioHistory          PortfolioHistory[]
  negotiationHistory        NegotiationHistory[]
  monitoringHistory         MonitoringHistory[]
  outreachHistory           OutreachHistory[]
  budgetHistory             BudgetHistory[]

  documents         GrantDocument[]
  GrantDraft        GrantDraft[]
  GrantSection      GrantSection[]
  ClusterAssignment ClusterAssignment[]

  source            GrantSource       @default(FEDERAL)
  tierAccess        GrantTierAccess   @default(FEDERAL_ONLY)

  amountMin         Float?
  amountMax         Float?
  totalFunding      Float?
  awardFloor        Float?
  awardCeiling      Float?
  expectedAwards    Int?

  postedDate        DateTime?
  updatedDate       DateTime?

  eligibility           Json?
  eligibleApplicants    String?
  ineligibleApplicants  String?

  eligibleStates    String?
  geographicFocus   String?

  foundationName        String?
  foundationEIN         String?
  foundationMission     String?
  foundationRestrictions String?
  foundationGivingAreas String?
  foundationPastGrantees Json?
  foundationBoardMembers Json?
  foundation990PF       Json?

  philanthropicType     String?
  philanthropicFocus    String?
  philanthropicHistory  Json?

  aiEligibilityScore      Float?
  aiAlignmentScore        Float?
  aiCompetitivenessScore  Float?
  aiRiskScore             Float?
  aiReadinessScore        Float?

  aiSummary          String?
  aiRecommendations  Json?

  tags               String[]
}

enum GrantSource {
  FEDERAL
  STATE
  FOUNDATION
  PHILANTHROPIC
}

enum GrantTierAccess {
  FEDERAL_ONLY
  FEDERAL_STATE
  PRO
  ENTERPRISE
}

model GrantDocument {
  id        String   @id @default(cuid())
  grantId   String
  filename  String
  url       String
  createdAt DateTime @default(now())

  grant Grant @relation(fields: [grantId], references: [id])
}

model GrantSection {
  id      String  @id @default(cuid())
  grantId String
  title   String
  content String?
  order   Int

  grant Grant @relation(fields: [grantId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])
}

model JobQueue {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  status    String   @default("pending")
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SharedResource {
  id           String   @id @default(cuid())
  resourceId   String
  ownerOrgId   String
  sharedWithId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerOrg   Org  @relation("OwnedResources", fields: [ownerOrgId], references: [id])
  sharedWith Org? @relation("SharedResources", fields: [sharedWithId], references: [id])

  accesses SharedAccess[]
}

model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs       AuditLog[]
  ownedResources  SharedResource[] @relation("OwnedResources")
  sharedResources SharedResource[] @relation("SharedResources")

  sharedAccess SharedAccess[]
  Workspace    Workspace[]
}

model SharedAccess {
  id        String   @id @default(cuid())
  orgId     String
  sharedId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Org            @relation(fields: [orgId], references: [id])
  shared SharedResource @relation(fields: [sharedId], references: [id])
}
model Document {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  title       String?
  content     Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  patches           DocumentPatch[]
  versions          DocumentVersion[]
  snapshots         DocumentSnapshot[]
  DocumentMessage   DocumentMessage[]
  DocumentComment   DocumentComment[]
  DocumentPresence  DocumentPresence[]
  Embedding         Embedding[]
  File              File[]
  DocumentEmbedding DocumentEmbedding?
}

model Budget {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  amount      Float?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Cluster {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())

  assignments ClusterAssignment[]
  history     ClusterHistory[]
}

model ClusterAssignment {
  id        String   @id @default(cuid())
  clusterId String
  grantId   String
  createdAt DateTime @default(now())

  cluster Cluster @relation(fields: [clusterId], references: [id])
  grant   Grant   @relation(fields: [grantId], references: [id])
}

model ClusterHistory {
  id        String   @id @default(cuid())
  clusterId String
  action    String?
  createdAt DateTime @default(now())

  cluster Cluster @relation(fields: [clusterId], references: [id])
}

model DocumentEmbedding {
  id          String    @id @default(cuid())
  documentId  String    @unique
  workspaceId String
  text        String
  vector      Float[]

  document    Document  @relation(fields: [documentId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model FileEmbedding {
  id          String    @id @default(cuid())
  fileId      String    @unique
  workspaceId String
  text        String
  vector      Float[]

  file        File      @relation(fields: [fileId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceActivity {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
}

model WorkspaceNotification {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceId  String
  userId       String?

  type         String
  message      String
  read         Boolean  @default(false)

  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])
}

model SearchAnalytics {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())

  workspaceId  String
  query        String
  resultCount  Int
  durationMs   Int

  workspace    Workspace @relation(fields: [workspaceId], references: [id])
}
model WorkspaceInsight {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())

  workspaceId  String
  title        String
  description  String?
  aiScore      Float?

  // Correct single relation
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceBilling {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  plan                  String   @default("free")
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  usageSearches         Int      @default(0)
  usageUploads          Int      @default(0)
  usageMembers          Int      @default(1)
  usageAI               Int      @default(0)
  periodStart           DateTime @default(now())
  periodEnd             DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceAddon {
  id          String   @id @default(cuid())
  workspaceId String
  type        String   // e.g. "state_grants", "ai_writer", "priority_support"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model AddonBilling {
  id                   String   @id @default(cuid())
  workspaceId          String
  addonType            String
  stripeSubscriptionId String?
  periodStart          DateTime @default(now())
  periodEnd            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model File {
  id          String  @id @default(cuid())
  workspaceId String?
  userId      String?
  documentId  String?

  filename String
  mimeType String
  size     Int
  url      String
  storage  String

  createdAt DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  document  Document?  @relation(fields: [documentId], references: [id])

  FileEmbedding FileEmbedding?
}

model GrantDraft {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  title     String?
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model Narrative {
  id        String   @id @default(cuid())
  userId    String
  grantId   String
  content   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])
}

model DocumentPresence {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  lastSeen   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId])
}

model DocumentMessage {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  message    String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  text       String
  selection  String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}
model WorkspaceReport {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
}
model WorkspaceBudget {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}
model WorkspaceDocument {
  id          String   @id @default(cuid())
  workspaceId String
  title       String?
  content     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}
model WorkspaceFile {
  id          String   @id @default(cuid())
  workspaceId String
  filename    String
  mimeType    String
  size        Int
  url         String
  storage     String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}
model WorkspaceEmbedding {
  id          String   @id @default(cuid())
  workspaceId String
  text        String
  vector      Float[]
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}
model GrantAccess {
  id         String   @id @default(cuid())
  grantId    String
  userId     String

  canView    Boolean  @default(true)
  canEdit    Boolean  @default(false)
  canRunAI   Boolean  @default(false)

  grant      Grant    @relation(fields: [grantId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([grantId, userId])
}
